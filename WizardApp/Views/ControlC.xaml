<UserControl x:Class="WizardApp.Views.ControlC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:input="clr-namespace:Syncfusion.Windows.Controls.Input;assembly=Syncfusion.SfInput.WPF"
             xmlns:til="clr-namespace:Syncfusion.UI.Xaml.TextInputLayout;assembly=Syncfusion.SfTextInputLayout.WPF"
             xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
             xmlns:tools="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.WPF"
             xmlns:tt="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.WPF">
    <UserControl.Resources>
        <Style x:Key="FieldLayout" TargetType="til:SfTextInputLayout">
            <Setter Property="ContainerType" Value="Outlined" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource Card}" MaxWidth="560" HorizontalAlignment="Left" VerticalAlignment="Top">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Employee details" Style="{StaticResource PageTitle}" FontSize="18" Margin="0,0,0,16" />

                <til:SfTextInputLayout Hint="First Name" Style="{StaticResource FieldLayout}"
                    HasError="{Binding Form[FirstName], Converter={StaticResource StringToBool}}"
                    ErrorText="{Binding Form[FirstName]}">
                    <input:SfTextBoxExt Text="{Binding Form.FirstName, UpdateSourceTrigger=PropertyChanged}" />
                </til:SfTextInputLayout>

                <til:SfTextInputLayout Hint="Last Name" Style="{StaticResource FieldLayout}"
                    HasError="{Binding Form[LastName], Converter={StaticResource StringToBool}}"
                    ErrorText="{Binding Form[LastName]}">
                    <input:SfTextBoxExt Text="{Binding Form.LastName, UpdateSourceTrigger=PropertyChanged}" />
                </til:SfTextInputLayout>

                <til:SfTextInputLayout Hint="Department" Style="{StaticResource FieldLayout}"
                    HasError="{Binding Form[Department], Converter={StaticResource StringToBool}}"
                    ErrorText="{Binding Form[Department]}">
                    <tools:ComboBoxAdv ItemsSource="{Binding Departments}" SelectedItem="{Binding Form.Department}" />
                </til:SfTextInputLayout>

                <til:SfTextInputLayout Hint="Joining Date" Style="{StaticResource FieldLayout}"
                    HasError="{Binding Form[JoiningDate], Converter={StaticResource StringToBool}}"
                    ErrorText="{Binding Form[JoiningDate]}">
                    <shared:DateTimeEdit Pattern="ShortDate" DateTime="{Binding Form.JoiningDate}" />
                </til:SfTextInputLayout>

                <!-- Syncfusion CheckListBox replaces native CheckBoxes. -->
                <tt:CheckListBox ItemsSource="{Binding Form.Options}" DisplayMemberPath="Label" IsCheckedMemberPath="IsChecked" />
                <TextBlock Text="{Binding Form.TermsError}" Foreground="#D13438" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
