<UserControl x:Class="WizardApp.Views.ControlB"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:grid="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF">
    <!-- Rows are UI-virtualized by default; sorting, filtering and grouping are enabled. -->
    <grid:SfDataGrid ItemsSource="{Binding Items}"
                     AutoGenerateColumns="False"
                     AllowSorting="True"
                     AllowFiltering="True"
                     AllowGrouping="True"
                     ShowGroupDropArea="True"
                     ColumnSizer="Star">
        <grid:SfDataGrid.Columns>
            <grid:GridNumericColumn HeaderText="Id" MappingName="Id" NumberDecimalDigits="0" />
            <grid:GridTextColumn HeaderText="Name" MappingName="Name" />
            <grid:GridTextColumn HeaderText="Department" MappingName="Department" />
            <grid:GridTextColumn HeaderText="Status" MappingName="Status" />
        </grid:SfDataGrid.Columns>
    </grid:SfDataGrid>
</UserControl>
