<Window x:Class="WizardApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
        xmlns:vm="clr-namespace:WizardApp.ViewModels"
        xmlns:views="clr-namespace:WizardApp.Views"
        syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManager ThemeName=FluentLight}"
        Title="Wizard" Height="600" Width="900" MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- DataTemplates resolve ViewModel -> View without reflection or Frame/Page navigation. -->
        <DataTemplate DataType="{x:Type vm:ControlAViewModel}"><views:ControlA /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ControlBViewModel}"><views:ControlB /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ControlCViewModel}"><views:ControlC /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="16,12" BorderThickness="0,0,0,1" BorderBrush="LightGray">
            <StackPanel>
                <TextBlock Text="Setup Wizard" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StepText}" Opacity="0.7" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Dynamic center region -->
        <ContentControl Grid.Row="1" Margin="16" Content="{Binding CurrentViewModel}" />

        <!-- Bottom navigation -->
        <Border Grid.Row="2" Padding="16,12" BorderThickness="0,1,0,0" BorderBrush="LightGray">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Previous" Width="100" Margin="0,0,8,0" Command="{Binding PreviousCommand}" />
                <Button Content="Next" Width="100" Command="{Binding NextCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
