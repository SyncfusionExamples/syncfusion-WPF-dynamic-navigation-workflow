<Window x:Class="WizardApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
        xmlns:tools="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.WPF"
        xmlns:vm="clr-namespace:WizardApp.ViewModels"
        xmlns:views="clr-namespace:WizardApp.Views"
        syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManager ThemeName=FluentLight}"
        Title="Wizard" Height="640" Width="960" MinHeight="420" MinWidth="680"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- DataTemplates resolve ViewModel -> View without reflection or Frame/Page navigation. -->
        <DataTemplate DataType="{x:Type vm:ControlAViewModel}"><views:ControlA /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ControlBViewModel}"><views:ControlB /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ControlCViewModel}"><views:ControlC /></DataTemplate>

        <Style x:Key="NavButton" TargetType="tools:ButtonAdv">
            <Setter Property="Width" Value="110" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="SizeMode" Value="Normal" />
            <Setter Property="SmallIcon" Value="{x:Null}" />
            <Setter Property="LargeIcon" Value="{x:Null}" />
        </Style>
    </Window.Resources>

    <Grid Background="#FAFAFA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,16" Background="{StaticResource HeaderBackgroundBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{StaticResource CardBorderBrush}">
            <StackPanel>
                <TextBlock Text="Setup Wizard" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding StepText}" Style="{StaticResource SubTitle}" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <ContentControl Grid.Row="1" Margin="24" Content="{Binding CurrentViewModel}" />

        <Border Grid.Row="2" Padding="24,12" Background="{StaticResource HeaderBackgroundBrush}"
                BorderThickness="0,1,0,0" BorderBrush="{StaticResource CardBorderBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <tools:ButtonAdv Label="Previous" Style="{StaticResource NavButton}" Command="{Binding PreviousCommand}" />
                <tools:ButtonAdv Label="Next" Style="{StaticResource NavButton}" Command="{Binding NextCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
